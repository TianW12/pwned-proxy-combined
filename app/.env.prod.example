# =============================================================================
# Production environment for the Django backend.
# Copy this to app/.env and fill in real values. NEVER commit the real .env.
# =============================================================================

# --- Django core ---
# A long random secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Keep DEBUG off in production.
DJANGO_DEBUG=false

# Hosts Django will accept requests for (comma-separated, no scheme).
DJANGO_ALLOWED_HOSTS=yoursite.com,api.yoursite.com

# The public host used to build absolute URLs (Swagger schema, etc.).
# Use the API host that external clients call.
DJANGO_DOMAIN=api.yoursite.com

# Origins allowed to POST/log in over HTTPS (MUST include the https:// scheme).
DJANGO_CSRF_TRUSTED_ORIGINS=https://yoursite.com,https://api.yoursite.com

# --- Database ---
# Use "postgres" in production so Django talks to the db container.
DJANGO_DATABASE_ENGINE=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=hibp
POSTGRES_USER=hibp
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- HaveIBeenPwned ---
# Optional: importing the domain list on first start.
HIBP_API_KEY=
